{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gcloud config list)",
      "Bash(gcloud builds list *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud logging read *)",
      "Bash(bq show *)",
      "Bash(bq ls *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gcloud run deploy *)",
      "Bash(gcloud builds submit *)",
      "Bash(bq query *)",
      "Bash(gh repo create *)",
      "Bash(gh pr merge *)",
      "Bash(gcloud * create *)",
      "Bash(gcloud * add-iam-policy-binding *)",
      "Bash(bq mk *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(gcloud projects delete *)",
      "Bash(gcloud * delete *)",
      "Bash(bq rm *)",
      "Edit(prompts/diagnostic_v1.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests_before_stop.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
